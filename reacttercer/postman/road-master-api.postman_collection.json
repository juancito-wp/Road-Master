{
  "info": {
    "name": "Road Master API",
    "description": "Pruebas de registro, login, JWT, roles y CRUD de Road Master.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "producto_id",
      "value": "1"
    },
    {
      "key": "usuario_id",
      "value": "1"
    },
    {
      "key": "servicio_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login correcto', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.token).to.be.a('string');",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.collectionVariables.set('usuario_id', json.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@roadmaster.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Registro cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registro aceptado', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Postman\",\n  \"apellido\": \"Prueba\",\n  \"tipoDocumento\": \"CC\",\n  \"numeroDocumento\": \"900000001\",\n  \"direccion\": \"Calle 10 # 20-30\",\n  \"telefono\": \"3001234567\",\n  \"email\": \"postman@roadmaster.com\",\n  \"password\": \"Postman123!\"\n}"
            },
            "url": "{{base_url}}/auth/registro"
          }
        },
        {
          "name": "Login invalido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Credenciales rechazadas', () => pm.expect([401, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"noexiste@roadmaster.com\",\n  \"password\": \"Incorrecta123!\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Usuarios admin",
      "item": [
        {
          "name": "Listar usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuarios consultados', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/usuarios"
          }
        },
        {
          "name": "Cambiar estado usuario",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"inactivo\"\n}"
            },
            "url": "{{base_url}}/usuarios/{{usuario_id}}/estado"
          }
        },
        {
          "name": "Consultar usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/usuarios/{{usuario_id}}"
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/usuarios/{{usuario_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Administrador\",\n  \"apellido\": \"Road Master\",\n  \"tipoDocumento\": \"CC\",\n  \"numeroDocumento\": \"100000001\",\n  \"direccion\": \"Calle 1 # 1-1\",\n  \"telefono\": \"3000000000\",\n  \"email\": \"admin@roadmaster.com\",\n  \"rol\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/usuarios/{{usuario_id}}"
          }
        },
        {
          "name": "Ruta sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ruta protegida', () => pm.expect([401, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/usuarios"
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Productos consultados', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/productos"
          }
        },
        {
          "name": "Crear producto con imagen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
                  "value": "Modelo Postman",
                  "type": "text"
                },
                {
                  "key": "marca",
                  "value": "Road Master",
                  "type": "text"
                },
                {
                  "key": "precio",
                  "value": "250000000",
                  "type": "text"
                },
                {
                  "key": "categoria",
                  "value": "Tractocamion",
                  "type": "text"
                },
                {
                  "key": "descripcion",
                  "value": "Producto creado desde Postman",
                  "type": "text"
                },
                {
                  "key": "imagen",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{base_url}}/productos"
          }
        },
        {
          "name": "Consultar producto",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/productos/{{producto_id}}"
          }
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/productos/{{producto_id}}",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
                  "value": "Modelo actualizado",
                  "type": "text"
                },
                {
                  "key": "marca",
                  "value": "Road Master",
                  "type": "text"
                },
                {
                  "key": "precio",
                  "value": "260000000",
                  "type": "text"
                },
                {
                  "key": "categoria",
                  "value": "Carga pesada",
                  "type": "text"
                },
                {
                  "key": "descripcion",
                  "value": "Actualizado desde Postman",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/productos/{{producto_id}}"
          }
        }
      ]
    },
    {
      "name": "Servicios",
      "item": [
        {
          "name": "Listar servicios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/servicios"
          }
        },
        {
          "name": "Crear servicio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mantenimiento preventivo\",\n  \"descripcion\": \"Servicio para vehiculos\",\n  \"precio\": 150000\n}"
            },
            "url": "{{base_url}}/servicios"
          }
        },
        {
          "name": "Actualizar servicio",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/servicios/{{servicio_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mantenimiento correctivo\",\n  \"descripcion\": \"Servicio actualizado\",\n  \"precio\": 180000\n}"
            }
          }
        },
        {
          "name": "Eliminar servicio",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/servicios/{{servicio_id}}"
          }
        }
      ]
    },
    {
      "name": "Solicitudes cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"modeloId\": 1,\n  \"tipoServicio\": \"Cotizacion\",\n  \"comentarios\": \"Solicitud de prueba\"\n}"
        },
        "url": "{{base_url}}/solicitudes"
      }
    }
  ]
}