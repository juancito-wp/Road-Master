DATABASE_URL=mysql+pymysql://root:password@localhost:3306/road_master
JWT_SECRET=change-this-secret-in-local-env
JWT_EXPIRE_HOURS=8
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5173
# ---- Envío de correos (recuperación de contraseña) ----
# Si defines varios bloques se usa el primero de este orden: puente de Gmail, Mailgun,
# Resend y SMTP.
#
# Puente de Gmail (recomendado): apunta a un Web App de Google Apps Script que envía con
# GmailApp desde tu propio Gmail. Es la única vía sin dominio propio cuyos correos llegan a
# la bandeja de entrada. Los pasos y el script están en docs/DESPLIEGUE.md.
# GMAIL_BRIDGE_TOKEN debe ser el mismo secreto que escribas dentro del script.
GMAIL_BRIDGE_URL=https://script.google.com/macros/s/tu-id-de-despliegue/exec
GMAIL_BRIDGE_TOKEN=un-secreto-largo-y-aleatorio
#
# Mailgun: envía sin dominio propio, pero su dominio sandbox está castigado por reputación,
# así que los correos suelen caer en spam. Sirve como respaldo del puente de Gmail.
# trae un dominio sandbox. Inconveniente: el sandbox solo entrega a los destinatarios que
# autorices en Send > Domains > (tu sandbox) > Setup, con un máximo de 5.
MAILGUN_API_KEY=tu-clave-privada
MAILGUN_DOMAIN=sandbox1234567890abcdef.mailgun.org
# 'us' o 'eu' según la región con la que creaste la cuenta.
MAILGUN_REGION=us
# Opcional: si lo omites se usa "Road Master <postmaster@MAILGUN_DOMAIN>".
MAILGUN_FROM=Road Master <postmaster@sandbox1234567890abcdef.mailgun.org>
#
# Resend (API por HTTPS): alternativa para cuando ya tengas un dominio propio verificado.
# Sin dominio verificado solo puede enviar al correo con el que te registraste. Clave en
# https://resend.com/api-keys
RESEND_API_KEY=re_tu_clave_aqui
RESEND_FROM=Road Master <onboarding@resend.dev>
# SMTP: alternativa que solo funciona en local o en el plan Pro de Railway.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-clave-de-aplicacion
SMTP_FROM=tu-correo@gmail.com

# ---- Quinto avance: facturación, IA y despliegue ----
# Porcentaje de impuesto aplicado por defecto a las ventas (IVA Colombia = 19)
IMPUESTO_PORCENTAJE=19
# Chatbot con Inteligencia Artificial (OpenAI). Sin clave responde en modo local.
OPENAI_API_KEY=sk-proj-tu-clave-aqui
OPENAI_MODEL=gpt-4o-mini
# URL pública del frontend desplegado (se usa en correos, chatbot y CORS)
PUBLIC_FRONTEND_URL=http://localhost:5173
# Orígenes permitidos separados por coma (CORS) - en producción: https://tu-frontend.up.railway.app
# FRONTEND_ORIGIN=https://tu-frontend.up.railway.app
